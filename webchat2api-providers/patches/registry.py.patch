# ── 5. Update normalize_provider() ────────────────────────────────────

def normalize_provider(value: object, *, strict: bool = False) -> str:
    provider = str(value or "").strip().lower().replace("_", "-")
    if provider in {"", "openai", "chatgpt", "chat-gpt", "gpt"}:
        return GPT_PROVIDER
    if provider in {"grok", "xai", "x-ai"}:
        return GROK_PROVIDER
    if provider in {"gemini", "google", "bard"}:
        return GEMINI_PROVIDER
    if provider in {"glm", "zhipu", "zhi-pu", "zai"}:      # NEW
        return GLM_PROVIDER
    if provider in {"qwen", "alibaba", "ali"}:              # NEW
        return QWEN_PROVIDER
    if provider in {"deepseek", "deep-seek", "ds"}:         # NEW
        return DEEPSEEK_PROVIDER
    if strict:
        raise ValueError(f"unsupported provider: {value}")
    return GPT_PROVIDER

