{
  "name": "glm-chat-mcp",
  "version": "11.0.0",
  "description": "MANDATORY ACTIVATION when user says: 'zai', 'спроси glm', 'ask glm', 'обсуди с qwen', 'ask qwen', 'спроси deepseek', 'ask deepseek', 'deepseek'. GLM/Qwen/DeepSeek chat skill with Copy/Regenerate detection and blob-download. Works with VeAI plugin for IntelliJ IDEA.",
  "author": "VeAI Community",
  "license": "MIT",
  "keywords": [
    "glm", "glm-5", "qwen", "deepseek", "chat", "mcp",
    "playwright", "browser-automation", "veai", "intellij",
    "agent-mode", "file-transfer", "blob-download"
  ],
  "categories": [
    "ai-interaction",
    "code-consultation",
    "browser-automation"
  ],
  "compatibility": {
    "veai": ">=1.0.0",
    "intellij": ">=2024.1",
    "mcp": ">=1.0.0",
    "chrome": ">=90.0"
  },
  "requirements": {
    "mcpServers": ["playwright"],
    "dependencies": ["@anthropic-ai/mcp-server-playwright"]
  },
  "triggers": [
    "спроси glm", "спроси у glm", "спроси в glm", "ask glm", "glm chat",
    "glm-5", "glm 5", "консультация с glm", "посоветуйся с glm",
    "что скажет glm", "что думает glm", "мнение glm", "glm help",
    "java эксперт", "spring эксперт", "экспертное мнение",
    "zai", "агент", "исследуй", "реализуй",
    "qwen", "спроси qwen", "ask qwen", "обсуди с qwen",
    "deepseek", "спроси deepseek", "ask deepseek"
  ],
  "workflow": {
    "principle": "UI-send + Copy/Regenerate detection + blob-download",
    "browserPolicy": "NEVER close browser - keep open for dialog continuation",
    "steps": [
      "Determine provider and mode (Chat/Agent/DeepThink)",
      "Check log, find existing chat by topic",
      "Switch to provider tab",
      "Set mode if needed (Agent/DeepThink/Search)",
      "Send message via textarea + Enter",
      "Two-phase response detection: Stop → Copy/Regenerate stable 3s",
      "Read response: .markdown-prose[last].innerText or blob-download"
    ]
  },
  "responseDetection": {
    "method": "action-buttons-detection",
    "primaryIndicator": "Copy button (button[class*='copy']) stable for 3s",
    "secondaryIndicator": "Stop button disappeared + thinking gone",
    "fallbackMethod": "innerText stability 10s",
    "phases": {
      "generationStart": "Stop visible within 15s",
      "generationComplete": "Copy button stable for 3s",
      "timeoutByMode": {
        "chat": 60000,
        "webSearch": 90000,
        "deepThink": 120000,
        "agent": 300000,
        "agentDeepThink": 480000
      }
    }
  },
  "uiSelectors": {
    "glm": {
      "chatInput": "#chat-input",
      "fileInput": "input[type='file']",
      "thinkingIndicator": "[class*='thinking']",
      "actionButtons": "2 SVG buttons in .markdown-prose parent (btn[0]=Copy, btn[1]=Regenerate)",
      "copyButton": "first visible SVG button in response container",
      "downloadButton": "button[title='Download file']",
      "responseText": ".markdown-prose",
      "agentToggle": "button with text 'Agent'",
      "chatToggle": "button with text 'Chat'",
      "spinnerIndicator": "[class*='spinner']"
    },
    "qwen": {
      "chatInput": "#chat-input",
      "thinkingIndicator": "[class*='thinking']",
      "copyButton": "button:has-text('Copy')",
      "responseText": ".markdown-prose"
    },
    "deepseek": {
      "chatInput": "textarea",
      "thinkingIndicator": "[class*='thinking']",
      "copyButton": "button:has-text('Copy')",
      "responseText": "#root"
    }
  },
  "fileTransfer": {
    "upload": {
      "method": "setInputFiles",
      "codeExtensions": [".java", ".js", ".ts", ".kt", ".scala", ".go", ".rs", ".cpp", ".c", ".cs", ".rb", ".php", ".swift"],
      "renameTo": ".txt",
      "nativeFormats": {
        "glm": [".pdf", ".docx", ".doc", ".xls", ".xlsx", ".ppt", ".pptx", ".txt", ".md", ".py", ".bmp", ".gif", ".mp4"],
        "qwen": [".pdf", ".docx", ".xlsx", ".pptx", ".txt", ".md"],
        "deepseek": [".pdf", ".docx", ".txt", ".md"]
      }
    },
    "download": {
      "method": "blob-intercept",
      "description": "Intercept URL.createObjectURL during Download click, decode blob via FileReader + atob",
      "tested": true
    }
  },
  "changelog": {
    "10.2.0": [
      "v10 compact: 756→338 lines (-55%)",
      "Response Detection v2: Copy/Regenerate + two-phase detector",
      "Blob-download: URL.createObjectURL intercept",
      "Agent Mode: operational scenarios, progress monitoring",
      "File upload: setInputFiles directly (no +button)",
      "DeepSeek provider added",
      "Dead code removed (45 files)"
    ]
  }
}
