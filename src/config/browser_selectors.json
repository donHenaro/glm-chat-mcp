{
  "meta": {
    "description": "Карта селекторов для GLM Chat Interface",
    "version": "1.0.0",
    "last_updated": "2025-01-01",
    "source": "z.ai chat.z.ai"
  },
  "elements": {
    "chat_input": {
      "description": "Поле ввода промпта",
      "type": "textbox",
      "selectors": [
        "textbox[placeholder*='How can I help']",
        "textbox[placeholder*='有什么可以帮您']",
        "textarea[id='prompt-textarea']",
        "div[contenteditable='true']"
      ],
      "notes": "Основной элемент для ввода текста"
    },
    "send_button": {
      "description": "Кнопка отправки сообщения",
      "type": "button",
      "selectors": [
        "button[aria-label='Send']",
        "button:has-text('Send')"
      ],
      "notes": "Обычно disabled, пока поле ввода пустое"
    },
    "stop_button": {
      "description": "Кнопка остановки генерации (появляется во время генерации)",
      "type": "button",
      "selectors": [
        "button[aria-label='Stop']",
        "button:has-text('Stop')"
      ],
      "notes": "Появляется во время генерации ответа"
    },
"response_container": {
      "description": "Контейнер с ответом ассистента",
      "type": "generic",
      "selectors": [
        ".markdown-content",
        ".assistant-message",
        "div[data-testid='response-content']"
      ],
      "notes": "Используется для ожидания и извлечения ответа"
    },
    "new_chat_button": {
      "description": "Кнопка создания нового чата (сброс контекста)",
      "type": "button",
      "selectors": [
        "a[href='/']",
        "button:has-text('New Chat')",
        "[data-testid='new-chat-button']"
      ],
      "notes": "Для сброса контекста между задачами"
    },
    "chat_url": {
      "description": "URL нового чата",
      "pattern": "/c/[a-f0-9-]+"
    },
    "response_code_block": {
      "description": "Блок кода внутри ответа ассистента",
      "type": "code",
      "selectors": [
        ".markdown-body pre code",
        "div[class*='code-block'] pre",
        "pre code",
        "[class*='language-']"
      ],
      "notes": "Для извлечения сгенерированного кода"
    },
    "copy_code_button": {
      "description": "Кнопка копирования кода",
      "type": "button",
      "selectors": [
        "button[aria-label*='Copy']",
        "button:has-text('Copy')",
        "[class*='copy-code']"
      ],
      "notes": "Для копирования кода из блока"
    },
    "agent_mode_button": {
      "description": "Кнопка включения агентского режима (Web Search + Tools)",
      "type": "button",
      "selectors": [
        "button[aria-label*='Agent']",
        "button:has-text('Agent')",
        "[data-testid='agent-toggle']",
        "button:has-text('MCP')"
      ],
      "state_detection": {
        "attribute": "aria-pressed",
        "active_value": "true",
        "inactive_value": "false"
      },
      "notes": "Для включения Agent Mode (Tool Use)"
    },
    "deep_think_button": {
      "description": "Кнопка включения режима глубокого мышления",
      "type": "button",
      "selectors": [
        "button:has-text('Deep think')",
        "[aria-label*='Deep think']",
        "[data-testid='deep-think']"
      ],
      "state_detection": {
        "attribute": "aria-pressed",
        "active_value": "true",
        "inactive_value": "false",
        "visual_indicator": "Deep think enabled"
      },
      "notes": "Deep Think Mode - Chain of Thought reasoning"
    },
"tools_menu_button": {
      "description": "Кнопка '+' для открытия меню инструментов",
      "type": "button",
      "selectors": [
        "button[aria-label='More']",
        "button[aria-label='Add']",
        "button[aria-label='Attach']",
        "button[aria-label='+']",
        "button svg[class*='plus']",
        "button[class*='attachment']"
      ],
      "notes": "Открывает dropdown меню с опциями: Upload, Search, Advanced Search"
    },
    "web_search_menu_item": {
      "description": "Пункт 'Search' в dropdown меню",
      "type": "menuitem",
      "selectors": [
        "button:has-text('Search')",
        "div[role='menuitem']:has-text('Search')",
        "div[role='menuitem']:has-text('联网搜索')",
        "li:has-text('Search')",
        "span:has-text('联网搜索')"
      ],
      "parent_menu": "div[role='menu']",
      "notes": "ВТОРОЙ пункт в меню (после Upload). Активирует Web Search."
    },
    "advanced_search_menu_item": {
      "description": "Пункт 'Advanced Search' в dropdown меню",
      "type": "menuitem",
      "selectors": [
        "button:has-text('Advanced Search')",
        "div[role='menuitem']:has-text('Advanced Search')",
        "div[role='menuitem']:has-text('深度搜索')"
      ],
      "parent_menu": "div[role='menu']",
      "notes": "Расширенный поиск с глубиной анализа"
    },
    "web_search_button": {
      "description": "Кнопка принудительного веб-поиска (Alternative - если есть прямая кнопка)",
      "type": "button",
      "selectors": [
        "button[aria-label='联网搜索']",
        "button[aria-label='Web Search']",
        "button[aria-label*='Search']",
        "button:has(svg[class*='globe'])",
        "button[data-testid='web-search-toggle']"
      ],
      "state_detection": {
        "attribute": "aria-pressed",
        "active_value": "true",
        "inactive_value": "false",
        "visual_indicator": "Web Search enabled"
      },
      "notes": "Fallback: прямая кнопка если есть. ОСНОВНОЙ метод - через меню (+ -> Search)"
    }
  },
  "scenarios": {
    "wait_for_response": {
      "strategy": "disappearance",
      "trigger": "stop_button",
      "timeout_ms": 120000,
      "description": "Ждём пока кнопка Stop не исчезнет"
    },
    "send_message": {
      "steps": [
        "1. Заполнить chat_input",
        "2. Нажать send_button",
        "3. Дождаться stop_button исчезновения"
      ]
    },
"set_mode": {
      "description": "Установка режима GLM перед отправкой",
      "modes": {
        "web_search": {
          "button": "web_search_button",
          "keywords": ["актуальн", "последн", "версия", "документация", "Maven", "latest", "version", "проверь", "current", "новейш"],
          "notes": "ПРИНУДИТЕЛЬНЫЙ поиск в интернете"
        },
        "agent": {
          "button": "agent_mode_button",
          "keywords": ["сгенерируй", "создай", "код", "implement", "generate"]
        },
        "deep_think": {
          "button": "deep_think_button",
          "keywords": ["архитектур", "проектир", "рефакторинг", "сложн", "architect", "refactor"]
        },
        "default": {
          "description": "Всё выключено"
        }
      }
    }
  }
}
